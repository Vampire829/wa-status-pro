{
  "name": "wa-status-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Самостоятельно размещаемая панель для публикации статусов WhatsApp на большую аудиторию.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "iconv-lite": "^0.6.3",
    "multer": "^2.0.2",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.17.0",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
