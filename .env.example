# Скопируйте в .env и замените пароль и секрет.
# Файл .env в git не попадает.

# Пароль единственного администратора панели. Минимум 8 символов.
ADMIN_PASSWORD=change-me-please

# Секрет подписи cookie. Минимум 16 символов. Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=замените-на-длинную-случайную-строку

# Сколько часов живёт вход в панель.
SESSION_TTL_HOURS=72

# Ставить Secure на cookie. Включайте, когда панель открывается только по HTTPS.
COOKIE_SECURE=0

# Доверять заголовку X-Forwarded-For от Caddy/nginx.
TRUST_PROXY=1

# Порт панели на сервере и внутри контейнера.
PORT=8080

# Адрес прослушивания. В Docker compose перекрывается на 0.0.0.0.
HOST=0.0.0.0

# Каталог данных при запуске без Docker. В контейнере всегда /data.
DATA_DIR=./data

# Сколько номеров в одной пачке statusJidList. От 1 до 500.
STATUS_BATCH_SIZE=100

# Пауза между пачками, миллисекунды. Минимум 500, рекомендуется 4000 и больше.
STATUS_BATCH_DELAY_MS=4000

# Пауза между разными публикациями, миллисекунды. 0 отключает.
MIN_PUBLISH_INTERVAL_MS=20000

# Максимальный размер загружаемого файла, мегабайты.
MAX_UPLOAD_MB=64

# Видео статуса обрезается до стольких секунд. Для WhatsApp разумно 30.
MAX_VIDEO_SECONDS=30

# Команда ffmpeg.
FFMPEG_PATH=ffmpeg

# Журнал приложения: info, warn, error.
LOG_LEVEL=info

# Журнал Baileys. silent, чтобы не забивать диск протоколом.
BAILEYS_LOG_LEVEL=silent

# 1 — просить у телефона полную историю чатов. Тяжелее для телефона и сервера.
# 0 — только недавняя история и контакты, которые WhatsApp отдаёт при привязке.
WA_SYNC_FULL_HISTORY=0

# Прокси только для трафика WhatsApp: сокет, загрузка и скачивание медиа, история чатов.
# Панель (браузер, вход, статика) ходит напрямую и эту переменную не использует.
# Пусто — прямое соединение с сервера.
# Схемы: http://  https://  socks5://  socks5h://
# socks5h резолвит имена WhatsApp на стороне прокси. Это предпочтительно, если DNS провайдера режет WhatsApp.
# Логин и пароль кодируйте в URL: символ @ в пароле записывается как %40.
# Пример: WA_PROXY_URL=socks5h://user:p%40ss@203.0.113.10:1080
WA_PROXY_URL=
